# Djinn Backend Environment Variables
# Copy this file to .env and fill in your values

# AI Model Configuration (At least one is required)
# 🦢 GOOGLE GEMINI (Free Tier - Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
# ⚡ GROQ (Llama 3)
GROQ_API_KEY=your_groq_api_key_here
# 🧡 CLAUDE (Anthropic API)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# 🤖 OPENAI (Paid Tier - Fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Google OAuth Client ID (for Google One Tap)
GOOGLE_CLIENT_ID=your_google_client_id_here

# LinkedIn API Credentials (for real LinkedIn automation)
LINKEDIN_CLIENT_ID=864e2441sn0prn
LINKEDIN_CLIENT_SECRET=WPL_AP1.i7aTtNLmQvB4CYai.OzcgTg==
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# X (Twitter) API Credentials (for real X automation)
X_CLIENT_ID=your_x_client_id_here
X_CLIENT_SECRET=your_x_client_secret_here
X_X_REDIRECT_URI=http://localhost:8000/api/auth/x/callback

# Supabase (optional — uses in-memory DB if not set)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Waitlist Email Notifications (Gmail SMTP)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-app-password

# App settings
APP_ENV=development
FRONTEND_URL=http://localhost:5173
